# ---------------------------------------------------------------------
# Nulle website — environment variables
# Copy to .env.local for development. Never commit real values.
# ---------------------------------------------------------------------

# Public address of the deployed site, no trailing slash.
# Used for canonical URLs, Open Graph, the sitemap, and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. A public contact address, shown in the contact section and
# footer. Leave empty to show no email address anywhere.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional. A public booking page (Cal.com, Calendly, Google Calendar
# appointment schedule, etc). Must be https. When set, visitors can pick
# a time themselves; when empty, consultations are arranged by reply.
NEXT_PUBLIC_SCHEDULING_URL=

# --- Contact form delivery (configure at least one channel) -----------

# Channel 1: email through Resend (https://resend.com).
# CONTACT_FROM_EMAIL must be on a domain verified in Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Channel 2: a webhook that receives each request as JSON
# (Slack workflow, Zapier, Make, a CRM, your own endpoint).
CONTACT_WEBHOOK_URL=

# --- Contact form protection -------------------------------------------

# Signs the form's anti-spam token. Use a long random string, for
# example the output of: openssl rand -hex 32
# Required when running more than one server instance.
CONTACT_FORM_SECRET=
